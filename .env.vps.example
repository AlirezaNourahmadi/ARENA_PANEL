ARENA_SITE_ADDRESS=http://SERVER_IP
ARENA_FALLBACK_TLS_PORT=8443
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-value

ARENA_ENV=production
ARENA_PUBLIC_URL=auto
ARENA_APP_SECRET=replace-with-at-least-32-random-characters
ARENA_GATEWAY_SECRET=replace-with-another-long-random-value
ARENA_ADMIN_USERNAME=admin
ARENA_ADMIN_PASSWORD=replace-with-a-strong-admin-password
ARENA_COOKIE_SECURE=false
ARENA_XRAY_ENABLED=true
ARENA_XRAY_BINARY=/usr/local/bin/xray
ARENA_XRAY_CONFIG_DIR=/tmp/arena-xray
ARENA_XRAY_LISTEN_HOST=0.0.0.0
ARENA_XRAY_API_HOST=127.0.0.1
ARENA_XRAY_API_PORT=10085
ARENA_XRAY_INTERNAL_HOST=arena
ARENA_XRAY_REALITY_ENABLED=true
ARENA_XRAY_REALITY_LISTEN_PORT=12000
ARENA_XRAY_REALITY_PUBLIC_PORT=2053
ARENA_XRAY_REALITY_PRIVATE_KEY=replace-with-xray-x25519-private-key
ARENA_XRAY_REALITY_PUBLIC_KEY=replace-with-matching-xray-x25519-public-key
ARENA_XRAY_REALITY_SHORT_ID=replace-with-even-length-hex-up-to-16-characters
ARENA_XRAY_REALITY_SERVER_NAME=www.google.com
ARENA_XRAY_REALITY_TARGET=www.google.com:443
ARENA_XRAY_STATS_INTERVAL_SECONDS=15
ARENA_GATEWAY_PUBLIC_PATH=/edge
ARENA_GATEWAY_WS_READ_LIMIT_BYTES=16777216
ARENA_TRUST_PROXY_HEADERS=true
ARENA_TRUSTED_PROXY_HOPS=1
ARENA_TRUST_CLOUDFLARE_HEADER=false
